# Grand Line Akinator - schema extension of kalnassag/one-piece-ontology.
# Base namespace (op:) is untouched; new terms live in opx:. Only RDFS/OWL RL-compatible axioms are used.
@prefix op:   <http://kalnassag.com/onepiece#> .
@prefix opx:  <http://kalnassag.com/onepiece-ext#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .

<http://kalnassag.com/onepiece-ext> a owl:Ontology ; owl:imports <http://kalnassag.com/onepiece> ;
    rdfs:comment "Extension of the One Piece ontology for the Grand Line Akinator demo."@en .

# ---- Affiliation taxonomy (members assigned by rules in app/extension.py) ----
opx:PirateOrganization a owl:Class ; rdfs:subClassOf op:Affiliation ; rdfs:label "Pirate organization"@en .
opx:MarineOrganization a owl:Class ; rdfs:subClassOf op:Affiliation ; rdfs:label "Marine organization"@en .
opx:RevolutionaryOrganization a owl:Class ; rdfs:subClassOf op:Affiliation ; rdfs:label "Revolutionary organization"@en .
opx:WorldGovernmentOrganization a owl:Class ; rdfs:subClassOf op:Affiliation ; rdfs:label "World Government organization"@en .

# ---- Derived character classes (OWL RL: cls-svf1 / cls-hv2) ----
opx:PirateAffiliatedCharacter a owl:Class ; rdfs:subClassOf op:Character ; rdfs:label "Pirate-affiliated character"@en .
opx:MarineAffiliatedCharacter a owl:Class ; rdfs:subClassOf op:Character ; rdfs:label "Marine-affiliated character"@en .
opx:RevolutionaryAffiliatedCharacter a owl:Class ; rdfs:subClassOf op:Character ; rdfs:label "Revolutionary-affiliated character"@en .
opx:WorldGovernmentAffiliatedCharacter a owl:Class ; rdfs:subClassOf op:Character ; rdfs:label "World Government-affiliated character"@en .
opx:DevilFruitUser a owl:Class ; rdfs:subClassOf op:Character ; rdfs:label "Devil Fruit user"@en .
opx:HakiUser a owl:Class ; rdfs:subClassOf op:Character ; rdfs:label "Haki user"@en .
opx:CaptainCharacter a owl:Class ; rdfs:subClassOf op:Character ; rdfs:label "Captain"@en .

[ a owl:Restriction ; owl:onProperty op:affiliatesWith ; owl:someValuesFrom opx:PirateOrganization ] rdfs:subClassOf opx:PirateAffiliatedCharacter .
[ a owl:Restriction ; owl:onProperty op:affiliatesWith ; owl:someValuesFrom opx:MarineOrganization ] rdfs:subClassOf opx:MarineAffiliatedCharacter .
[ a owl:Restriction ; owl:onProperty op:affiliatesWith ; owl:someValuesFrom opx:RevolutionaryOrganization ] rdfs:subClassOf opx:RevolutionaryAffiliatedCharacter .
[ a owl:Restriction ; owl:onProperty op:affiliatesWith ; owl:someValuesFrom opx:WorldGovernmentOrganization ] rdfs:subClassOf opx:WorldGovernmentAffiliatedCharacter .
[ a owl:Restriction ; owl:onProperty op:hasDevilFruit ; owl:someValuesFrom op:DevilFruit ] rdfs:subClassOf opx:DevilFruitUser .
[ a owl:Restriction ; owl:onProperty opx:hasHaki ; owl:someValuesFrom opx:HakiType ] rdfs:subClassOf opx:HakiUser .
[ a owl:Restriction ; owl:onProperty op:occupation ; owl:hasValue op:Captain ] rdfs:subClassOf opx:CaptainCharacter .
[ a owl:Restriction ; owl:onProperty op:occupation ; owl:hasValue op:Pirate_Captain ] rdfs:subClassOf opx:CaptainCharacter .
# "pirate" is recorded in two places that disagree (Kaido / Boa Hancock: pirate crew but no Pirate occupation; 192 such characters, 69 the other way):
# make them one fact.  pirate crew member <=> occupation Pirate (OWL RL cls-hv1 / cls-hv2).
opx:PirateAffiliatedCharacter rdfs:subClassOf [ a owl:Restriction ; owl:onProperty op:occupation ; owl:hasValue op:Pirate ] .
[ a owl:Restriction ; owl:onProperty op:occupation ; owl:hasValue op:Pirate ] rdfs:subClassOf opx:PirateAffiliatedCharacter .

# ---- Devil Fruit ownership: base ontology declares op:hasDevilFruit but data only has the inverse ----
op:DevilFruitCurrentUser owl:inverseOf op:hasDevilFruit .
op:DevilFruitPreviousUser owl:inverseOf opx:previouslyHadDevilFruit .
opx:previouslyHadDevilFruit a owl:ObjectProperty ; rdfs:domain op:Character ; rdfs:range op:DevilFruit .

# ---- Devil Fruit sub-types (Ancient / Mythical Zoan) via property chain (OWL RL prp-spo2) ----
# sub-types are their own class: op:DevilFruitType is closed upstream (owl:oneOf Paramecia Zoan Logia)
opx:DevilFruitSubtype a owl:Class ; rdfs:label "Devil Fruit sub-type"@en .
opx:AncientZoan a opx:DevilFruitSubtype ; rdfs:label "Ancient Zoan"@en .
opx:MythicalZoan a opx:DevilFruitSubtype ; rdfs:label "Mythical Zoan"@en .
opx:hasFruitSubtype a owl:ObjectProperty ; rdfs:domain op:DevilFruit ; rdfs:range opx:DevilFruitSubtype ;
    rdfs:comment "Fine-grained fruit type (curated)."@en .
opx:subtypeOf a owl:ObjectProperty ; rdfs:domain opx:DevilFruitSubtype ; rdfs:range op:DevilFruitType .
opx:AncientZoan opx:subtypeOf op:Zoan .
opx:MythicalZoan opx:subtypeOf op:Zoan .
# upstream values that are subtypes, not types (patches/fruit-subtypes): every SMILE is a Zoan, the Mochi-Mochi Fruit a Paramecia
op:Artificial_Zoan a opx:DevilFruitSubtype ; rdfs:label "Artificial Zoan"@en ; opx:subtypeOf op:Zoan .
op:Special_Paramecia a opx:DevilFruitSubtype ; rdfs:label "Special Paramecia"@en ; opx:subtypeOf op:Paramecia .
op:hasFruitType owl:propertyChainAxiom ( opx:hasFruitSubtype opx:subtypeOf ) .

# ---- Haki ----
opx:HakiType a owl:Class ; rdfs:label "Haki type"@en .
opx:ArmamentHaki a opx:HakiType ; rdfs:label "Armament Haki"@en .
opx:ObservationHaki a opx:HakiType ; rdfs:label "Observation Haki"@en .
opx:ConquerorsHaki a opx:HakiType ; rdfs:label "Conqueror's Haki"@en .
opx:hasHaki a owl:ObjectProperty ; rdfs:domain op:Character ; rdfs:range opx:HakiType .

# ---- Ships ----
opx:Ship a owl:Class ; rdfs:label "Ship"@en .
opx:PirateShip a owl:Class ; rdfs:subClassOf opx:Ship ; rdfs:label "Ship used by a pirate crew"@en .
opx:ShipType a owl:Class ; rdfs:label "Ship type"@en .
opx:shipOwner a owl:ObjectProperty ; rdfs:domain opx:Ship ; rdfs:range op:Character ; owl:inverseOf opx:ownsShip .
opx:ownsShip a owl:ObjectProperty ; rdfs:domain op:Character ; rdfs:range opx:Ship .
opx:operatedBy a owl:ObjectProperty ; rdfs:domain opx:Ship ; rdfs:range op:Affiliation ; rdfs:label "operated by crew"@en .
opx:shipType a owl:ObjectProperty ; rdfs:domain opx:Ship ; rdfs:range opx:ShipType .
opx:builtBy a owl:ObjectProperty ; rdfs:domain opx:Ship ; rdfs:range op:Character .
[ a owl:Restriction ; owl:onProperty opx:operatedBy ; owl:someValuesFrom opx:PirateOrganization ] rdfs:subClassOf opx:PirateShip .
# Owning a ship makes you a ship owner (hasValue-free: use domain of ownsShip via restriction)
opx:ShipOwner a owl:Class ; rdfs:subClassOf op:Character ; rdfs:label "Ship owner"@en .
[ a owl:Restriction ; owl:onProperty opx:ownsShip ; owl:someValuesFrom opx:Ship ] rdfs:subClassOf opx:ShipOwner .
# state of a ship (Destroyed / Active); upstream recorded it as a character status (patches/ship-twins)
opx:shipStatus a owl:ObjectProperty ; rdfs:domain opx:Ship ; rdfs:label "ship status"@en .
# a crew member sails on the ships their crew operates: "which ship is Nami usually on?" (OWL RL prp-inv + prp-spo2)
opx:operates a owl:ObjectProperty ; owl:inverseOf opx:operatedBy .
opx:sailsOn a owl:ObjectProperty ; rdfs:domain op:Character ; rdfs:range opx:Ship ; rdfs:label "sails on"@en ;
    owl:propertyChainAxiom ( op:affiliatesWith opx:operates ) .

# ---- Debut data patch: later appearances demoted from op:mangaDebut / op:animeDebut (ontology/patches/*.ttl) ----
opx:laterMangaAppearance a owl:ObjectProperty ; rdfs:domain op:Character ; rdfs:range op:MangaIssue ;
    rdfs:comment "A later manga appearance that upstream mis-recorded as a second op:mangaDebut."@en .
opx:laterAnimeAppearance a owl:ObjectProperty ; rdfs:domain op:Character ; rdfs:range op:AnimeEpisode ;
    rdfs:comment "A later anime appearance that upstream mis-recorded as a second op:animeDebut."@en .

# ---- "ever ate a Devil Fruit": current OR previous user (a player thinking of Whitebeard says YES; the graph has him as previous user of Gura Gura) ----
opx:ateDevilFruit a owl:ObjectProperty ; rdfs:domain op:Character ; rdfs:range op:DevilFruit ; rdfs:label "ate Devil Fruit (now or before)"@en .
op:hasDevilFruit rdfs:subPropertyOf opx:ateDevilFruit .
opx:previouslyHadDevilFruit rdfs:subPropertyOf opx:ateDevilFruit .
opx:DevilFruitEater a owl:Class ; rdfs:subClassOf op:Character ; rdfs:label "Devil Fruit eater (current or former user)"@en .
[ a owl:Restriction ; owl:onProperty opx:ateDevilFruit ; owl:someValuesFrom op:DevilFruit ] rdfs:subClassOf opx:DevilFruitEater .

# ---- occupation hierarchy: a Pirate Captain / Pirate Officer is also a Pirate (OWL RL prp-spo2 property chain) ----
opx:broaderOccupation a owl:ObjectProperty ; rdfs:domain op:Occupation ; rdfs:range op:Occupation ;
    rdfs:comment "Curated: the more general occupation of a specific one."@en .
op:occupation owl:propertyChainAxiom ( op:occupation opx:broaderOccupation ) .

# ==== constraints (docs/ONTOLOGY_CONSTRAINTS.md).  OWL RL derives the positive consequences and turns a violation into an owlrl error,
# which fails the ingestion (ontology.clashes).  Each one was measured against the patched data: 0 violations.

# enumerations whose members are pairwise different values.  ontology.closed_enumerations() writes the owl:differentFrom pairs at load time
# (owlrl's owl:AllDifferent never checks pairs with the last list member).  op:Status is NOT one: "Unknown" is not a state of the world.
opx:ClosedEnumeration a owl:Class ; rdfs:label "closed enumeration"@en .
op:DevilFruitType a opx:ClosedEnumeration .
opx:DevilFruitSubtype a opx:ClosedEnumeration .
op:BloodType a opx:ClosedEnumeration .
op:Race a opx:ClosedEnumeration .
opx:ShipType a opx:ClosedEnumeration .

# C1: a character, a Devil Fruit and a ship are different kinds of thing
[] a owl:AllDisjointClasses ; owl:members ( op:Character op:DevilFruit opx:Ship ) .

# C2: one status per character; alive and deceased exclude each other
op:statusOfCharacter a owl:FunctionalProperty .
op:Alive owl:differentFrom op:Deceased .
opx:LivingCharacter a owl:Class ; rdfs:subClassOf op:Character ; rdfs:label "Living character"@en ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty op:statusOfCharacter ; owl:hasValue op:Alive ] .
opx:DeceasedCharacter a owl:Class ; rdfs:subClassOf op:Character ; rdfs:label "Deceased character"@en ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty op:statusOfCharacter ; owl:hasValue op:Deceased ] .
opx:LivingCharacter owl:disjointWith opx:DeceasedCharacter .

# C3 / C4: a Devil Fruit has one type (Paramecia / Zoan / Logia) and at most one sub-type.  A CHARACTER can still eat two (Blackbeard).
op:hasFruitType a owl:FunctionalProperty .
opx:hasFruitSubtype a owl:FunctionalProperty .

# C5: a fruit is released on its user's death: a dead character holds none now (opx:DevilFruitEater, "ate one once", stays possible)
opx:DeceasedCharacter owl:disjointWith opx:DevilFruitUser .

# C6 / C7: one current user per fruit, and the current user is not also a previous user of it.  op:hasDevilFruit is NOT functional (Blackbeard).
op:DevilFruitCurrentUser a owl:FunctionalProperty .
op:hasDevilFruit a owl:InverseFunctionalProperty .
op:DevilFruitCurrentUser owl:propertyDisjointWith op:DevilFruitPreviousUser .

# C8: characters are not values, and these value kinds do not overlap (data-quality guard)
op:Character owl:disjointWith op:Status, op:DevilFruitType, opx:DevilFruitSubtype, opx:HakiType, opx:ShipType, op:BloodType, op:Race,
    op:MangaIssue, op:AnimeEpisode, op:Arc, op:Bounty, schema:Person .
[] a owl:AllDisjointClasses ; owl:members ( op:DevilFruit opx:Ship op:Occupation op:Location op:Status op:DevilFruitType ) .

# C10: single-valued facts
op:hasBloodType a owl:FunctionalProperty .
op:race a owl:FunctionalProperty .
opx:shipOwner a owl:FunctionalProperty .
opx:operatedBy a owl:FunctionalProperty .
opx:shipType a owl:FunctionalProperty .
