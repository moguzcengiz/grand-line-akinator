opx:evidenceCampaign031BepoBountyAmount a rdf:Statement ;
    opx:confidence "high" ;
    opx:sourceReference "The official profile lists Bepo’s bounty as 1,500 berries." ;
    opx:sourceType "official character profile" ;
    opx:temporalScope "official profile snapshot" ;
    rdf:object 1500 ;
    rdf:predicate op:bountyAmount ;
    rdf:subject op:Bepo_Bounty_Profile ;
    prov:wasDerivedFrom <https://one-piece.com/character/Bepo/index.html> .

