    rdf:predicate rdf:type ;
    rdf:subject op:Ally_of_theRed_Hair_Pirates ;
    prov:wasDerivedFrom <https://onepiece.fandom.com/wiki/Gerotini>, <https://onepiece.fandom.com/wiki/Chapter_1079> .

opx:evidenceCampaign043003 a rdf:Statement ;
    opx:confidence "high" ;
