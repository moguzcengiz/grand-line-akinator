# Official Gerd profile specifies Elbaph as her origin while the graph records only Grand Line.
op:Gerd op:placeOfOrigin op:Elbaph .
opx:evidenceCampaign043004 a rdf:Statement ;
    opx:confidence "high" ;
    opx:sourceReference "The official profile specifies Elbaph within the Grand Line as Gerd's origin; add the specific location while retaining the existing broad region." ;
    opx:sourceType "official character profile" ;
    opx:temporalScope "profile identity fact" ;
    rdf:object op:Elbaph ;
    rdf:predicate op:placeOfOrigin ;
    rdf:subject op:Gerd ;
    prov:wasDerivedFrom <https://one-piece.com/character/Gerd/index.html> .

