# The Red Hair subordinate crew is an allied affiliation, not the core crew.
op:Ally_of_theRed_Hair_Pirates a op:Affiliation ;
    rdfs:label "Allied crews of the Red Hair Pirates"@en .
op:Gerotini op:affiliatesWith op:Ally_of_theRed_Hair_Pirates .

opx:evidenceCampaign043001 a rdf:Statement ;
    opx:confidence "high" ;
    opx:sourceReference "Chapter 1079 identifies Gerotini as captain of the Puddle Pirates, one of the Red Hair allied crews. Model the Red Hair relationship as an allied affiliation rather than core-crew membership." ;
    opx:sourceType "manga chapter; chapter-referenced character profile" ;
    opx:temporalScope "allied crew at Elbaph in chapter 1079" ;
    rdf:object op:Ally_of_theRed_Hair_Pirates ;
    rdf:predicate op:affiliatesWith ;
    rdf:subject op:Gerotini ;
    prov:wasDerivedFrom <https://onepiece.fandom.com/wiki/Gerotini>, <https://onepiece.fandom.com/wiki/Chapter_1079> .

opx:evidenceCampaign043002 a rdf:Statement ;
    opx:confidence "high" ;
    opx:sourceReference "The existing affiliation category is represented as an Affiliation individual, consistent with the ontology's Whitebeard allied-pirate category." ;
    opx:sourceType "modeled from source-backed relationship" ;
    opx:temporalScope "current category definition" ;
