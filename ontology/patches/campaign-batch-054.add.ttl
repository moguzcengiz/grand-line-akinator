# Maidy's upstream role and residence were concatenated into malformed values.
op:Maidy op:occupation op:Maid .
opx:evidenceCampaign054001 a rdf:Statement ;
    opx:confidence "high" ;
    opx:sourceReference "The official character profile identifies Maidy as a maid of Alubarna Palace; chapter 215 depicts her serving Vivi." ;
    opx:sourceType "official character profile and manga chapter" ;
    opx:temporalScope "current role; chapter 215 and the official profile" ;
    rdf:subject op:Maidy ; rdf:predicate op:occupation ; rdf:object op:Maid ;
    prov:wasDerivedFrom <https://one-piece.com/character/Maidy/index.html>, <https://www.viz.com/shonenjump/one-piece-chapter-215/chapter/> .

op:Maidy op:residence op:Alubarna .
opx:evidenceCampaign054002 a rdf:Statement ;
    opx:confidence "high" ;
    opx:sourceReference "The official character profile says Maidy serves as a maid in Alubarna Palace." ;
    opx:sourceType "official character profile" ;
    opx:temporalScope "current or time-unspecified residence" ;
    rdf:subject op:Maidy ; rdf:predicate op:residence ; rdf:object op:Alubarna ;
    prov:wasDerivedFrom <https://one-piece.com/character/Maidy/index.html> .

op:Maidy op:residence op:Arabasta_Kingdom .
opx:evidenceCampaign054003 a rdf:Statement ;
    opx:confidence "high" ;
    opx:sourceReference "The official profile places Maidy under the Arabasta Kingdom; the official Vivre Card revision confirms her Arabasta Kingdom affiliation." ;
    opx:sourceType "official character profile and official Vivre Card revision" ;
    opx:temporalScope "current or time-unspecified residence" ;
    rdf:subject op:Maidy ; rdf:predicate op:residence ; rdf:object op:Arabasta_Kingdom ;
    prov:wasDerivedFrom <https://one-piece.com/character/Maidy/index.html>, <https://one-piece.com/vivre/revision/index.html> .

