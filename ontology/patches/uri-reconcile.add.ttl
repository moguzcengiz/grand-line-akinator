# Patch 'uri-reconcile' (triples ADDED in their place). Generated by `python -m app.patching`; upstream files in ontology-src/ are never modified.
# Object URIs that differ from a real Character only by punctuation (e.g. Monkey_D._Luffy vs Monkey_D_Luffy) re-pointed to it.
@prefix op: <http://kalnassag.com/onepiece#> .

op:Gomu_Gomu_no_Mi op:DevilFruitCurrentUser op:Monkey_D_Luffy .

op:Gura_Gura_no_Mi op:DevilFruitCurrentUser op:Marshall_D_Teach .

op:Mera_Mera_no_Mi op:DevilFruitPreviousUser op:Portgas_D_Ace .

op:Ope_Ope_no_Mi op:DevilFruitCurrentUser op:Trafalgar_D_Water_Law .

op:Yami_Yami_no_Mi op:DevilFruitCurrentUser op:Marshall_D_Teach .

