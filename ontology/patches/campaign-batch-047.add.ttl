  opx:sourceReference "Hoe is described as King Neptune's pet whale; keep the existing Pet occupation after removing the malformed concatenated occupation URI." ;
  opx:sourceType "chapter-referenced character profile" ; opx:temporalScope "profile snapshot" ;
  rdf:subject op:Hoe ; rdf:predicate op:occupation ; rdf:object op:Pet ;
  prov:wasDerivedFrom <https://onepiece.fandom.com/wiki/Hoe> .

