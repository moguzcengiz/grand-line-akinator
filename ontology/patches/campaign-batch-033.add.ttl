opx:evidenceCampaign033CavendishBounty a rdf:Statement ;
    opx:confidence "high" ;
    opx:sourceReference "The official character profile lists Cavendish's bounty as 330 million berries. It does not label this amount current or former, so no temporal status is asserted." ;
    opx:sourceType "official character profile" ;
    opx:temporalScope "official profile snapshot; no explicit current/former qualifier" ;
    rdf:object op:Cavendish_Bounty_Profile ;
    rdf:predicate op:hasBounty ;
    rdf:subject op:Cavendish ;
    prov:wasDerivedFrom <https://one-piece.com/character/cavendish/index.html> .

