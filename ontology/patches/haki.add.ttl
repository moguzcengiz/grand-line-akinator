# Evidence-backed Haki additions. Source records are in docs/ONTOLOGY_ENRICHMENT_SOURCES.md
# and represented below as RDF reification records. Each edge is a positive canon fact;
# absence of an edge remains unknown.
@prefix op: <http://kalnassag.com/onepiece#> .
@prefix opx: <http://kalnassag.com/onepiece-ext#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

op:Usopp opx:hasHaki opx:ObservationHaki .
op:Koby opx:hasHaki opx:ArmamentHaki, opx:ObservationHaki .
op:Yamato opx:hasHaki opx:ArmamentHaki, opx:ObservationHaki, opx:ConquerorsHaki .
op:Charlotte_Katakuri opx:hasHaki opx:ConquerorsHaki .

# Reified, queryable provenance for each asserted fact.
opx:evidenceUsoppObservation a rdf:Statement ;
  rdf:subject op:Usopp ; rdf:predicate opx:hasHaki ; rdf:object opx:ObservationHaki ;
  prov:wasDerivedFrom <https://onepiece.fandom.com/wiki/Usopp/Abilities_and_Powers> ;
  opx:sourceType "secondary reference citing manga" ;
  opx:sourceReference "Chapter 758 (Dressrosa); Usopp sights auras across the island and targets Sugar" ;
  opx:confidence "high" ; opx:temporalScope "canon fact; time-unspecified" .

