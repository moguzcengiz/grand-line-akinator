# Attributes extracted from the One Piece Fandom wiki (https://onepiece.fandom.com, text CC-BY-SA 3.0) by app.wiki_pipeline.
# Generated: python -m app.wiki_pipeline emit.  Only values a page states (infobox / category membership) are asserted; absence stays unknown.
# current/former affiliation and occupation are ADDITIVE to the timeless op:affiliatesWith / op:occupation edges, which are untouched.
@prefix op: <http://kalnassag.com/onepiece#> .
@prefix opx: <http://kalnassag.com/onepiece-ext#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct: <http://purl.org/dc/terms/> .

# ---- schema
opx:Gender a owl:Class ; rdfs:label "gender"@en .
opx:FightingStyle a owl:Class ; rdfs:label "fighting style"@en .
opx:Title a owl:Class ; rdfs:label "title"@en .
opx:BountyTier a owl:Class ; rdfs:label "bounty tier"@en .
opx:Gender a opx:ClosedEnumeration .   # Male and Female are different values (owl:differentFrom pairs are generated at load)
opx:WikiPage a owl:Class ; rdfs:label "wiki source page"@en .
opx:gender a owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain op:Character ; rdfs:range opx:Gender ; rdfs:label "gender"@en .
opx:fightingStyle a owl:ObjectProperty ; rdfs:domain op:Character ; rdfs:range opx:FightingStyle ; rdfs:label "fighting style / weapon class"@en .
opx:hasTitle a owl:ObjectProperty ; rdfs:domain op:Character ; rdfs:range opx:Title ; rdfs:label "title or group (Emperor, Warlord, Worst Generation ...)"@en .
opx:currentAffiliation a owl:ObjectProperty ; rdfs:domain op:Character ; rdfs:range opx:Affiliation ; rdfs:label "current affiliation"@en .
opx:formerAffiliation a owl:ObjectProperty ; rdfs:domain op:Character ; rdfs:range opx:Affiliation ; rdfs:label "former affiliation"@en .
opx:currentOccupation a owl:ObjectProperty ; rdfs:domain op:Character ; rdfs:range opx:Occupation ; rdfs:label "current occupation"@en .
opx:formerOccupation a owl:ObjectProperty ; rdfs:domain op:Character ; rdfs:range opx:Occupation ; rdfs:label "former occupation"@en .
opx:bountyTier a owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain op:Character ; rdfs:range opx:BountyTier ; rdfs:label "highest bounty"@en .
opx:wikiSource a owl:ObjectProperty ; rdfs:range opx:WikiPage ; rdfs:comment "Page the wiki-derived facts of this entity were read from."@en .
opx:revisionId a owl:DatatypeProperty .

