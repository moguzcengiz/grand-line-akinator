<http://kalnassag.com/onepiece#Ryu_Ryu_no_Mi,_Model:_Spinosaurus> a op:DevilFruit ;
    rdfs:label "リュウリュウの実 古代種 モデル 〝スピノサウルス〟"@ja ;
    op:DevilFruitCurrentUser op:Page_One ;
    op:hasFruitType op:Zoan ;
    opx:hasFruitSubtype opx:AncientZoan .

