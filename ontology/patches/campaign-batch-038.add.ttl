# Source-backed enrichment; every added factual triple has an rdf:Statement provenance record.
@prefix op: <http://kalnassag.com/onepiece#> .
@prefix opx: <http://kalnassag.com/onepiece-ext#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

opx:evidenceCampaign038CoribouBounty a rdf:Statement ;
    opx:confidence "high" ;
    opx:sourceReference "The official Coribou profile lists a 190,000,000 berry bounty. The profile does not mark the amount current or former." ;
    opx:sourceType "official character profile" ;
    opx:temporalScope "official profile snapshot; no explicit current/former qualifier" ;
    rdf:object op:Coribou_Bounty_Profile ;
    rdf:predicate op:hasBounty ;
    rdf:subject op:Coribou ;
    prov:wasDerivedFrom <https://one-piece.com/character/Coribou/index.html> .

