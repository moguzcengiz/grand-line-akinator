# Copy to .env and fill in.
TOGETHER_API_KEY=your_together_ai_key_here
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
TOGETHER_BASE_URL=https://api.together.xyz/v1
# Fuseki admin password (needed for writes); avoid the characters / & \
FUSEKI_PASSWORD=change_me_please
# optional engine knobs: CLOSED_WORLD (1; 0 = old open world) MAX_QUESTIONS (20) STOP_CONFIDENCE IG_FLOOR ABSENCE_RELIABILITY MIN_SUPPORT MIN_QUESTIONS
# player feedback is written to ./work/player-feedback/games.jsonl (report: docker compose exec backend python -m app.feedback_report)
# host ports (defaults 8000 / 3000); change if they are taken
#BACKEND_PORT=8000
#FRONTEND_PORT=3000
#FUSEKI_PORT=3030
